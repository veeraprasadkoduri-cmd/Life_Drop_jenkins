pipeline {

    agent any

    environment {

        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '424957012022'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        FRONTEND_REPO = 'frontend'
        BACKEND_REPO  = 'backend'
        DATABASE_REPO = 'database'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -e

                    echo "===== Docker ====="
                    docker --version

                    echo "===== AWS CLI ====="
                    aws --version

                    echo "===== Git ====="
                    git --version
                '''
            }
        }

        stage('AWS Authentication') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-ecr-credentials']
                ]) {
                    sh '''
                        set -e

                        echo "===== AWS Identity ====="

                        aws sts get-caller-identity

                        echo "===== ECR Login ====="

                        aws ecr get-login-password \
                            --region ${AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin \
                            ${ECR_REGISTRY}
                    '''
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    set -e

                    echo "===== Building Frontend ====="

                    docker build \
                        -t ${ECR_REGISTRY}/${FRONTEND_REPO}:${IMAGE_TAG} \
                        ./frontend
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    set -e

                    echo "===== Building Backend ====="

                    docker build \
                        -t ${ECR_REGISTRY}/${BACKEND_REPO}:${IMAGE_TAG} \
                        ./backend
                '''
            }
        }

        stage('Build Database Image') {
            steps {
                sh '''
                    set -e

                    echo "===== Building Database ====="

                    docker build \
                        -t ${ECR_REGISTRY}/${DATABASE_REPO}:${IMAGE_TAG} \
                        ./database
                '''
            }
        }

        stage('Docker Images') {
            steps {
                sh '''
                    echo "===== Local Docker Images ====="

                    docker images | grep ${ECR_REGISTRY}
                '''
            }
        }

        stage('Push Images to ECR') {
            steps {
                sh '''
                    set -e

                    echo "===== Push Frontend ====="

                    docker push \
                        ${ECR_REGISTRY}/${FRONTEND_REPO}:${IMAGE_TAG}


                    echo "===== Push Backend ====="

                    docker push \
                        ${ECR_REGISTRY}/${BACKEND_REPO}:${IMAGE_TAG}


                    echo "===== Push Database ====="

                    docker push \
                        ${ECR_REGISTRY}/${DATABASE_REPO}:${IMAGE_TAG}
                '''
            }
        }

        stage('Verify ECR') {
            steps {
                sh '''
                    set -e

                    echo "===== Frontend ECR ====="

                    aws ecr describe-images \
                        --repository-name ${FRONTEND_REPO} \
                        --region ${AWS_REGION}


                    echo "===== Backend ECR ====="

                    aws ecr describe-images \
                        --repository-name ${BACKEND_REPO} \
                        --region ${AWS_REGION}


                    echo "===== Database ECR ====="

                    aws ecr describe-images \
                        --repository-name ${DATABASE_REPO} \
                        --region ${AWS_REGION}
                '''
            }
        }
    }

    post {

        success {
            echo '''
            ==========================================
            BUILD SUCCESSFUL
            Docker images pushed to AWS ECR
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
            BUILD FAILED
            Check Jenkins Console Output
            ==========================================
            '''
        }
    }
}
