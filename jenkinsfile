```groovy
pipeline {

    agent any

    environment {

        AWS_REGION = 'ap-south-1'

        AWS_ACCOUNT_ID = '424957012022'

        ECR_REPO = 'nodejs-app'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        IMAGE_NAME = "${ECR_REGISTRY}/${ECR_REPO}"

        IMAGE_TAG = "${BUILD_NUMBER}"

        EKS_CLUSTER = 'my-eks-cluster'

        HELM_RELEASE = 'nodejs-app'

        HELM_CHART = './helm/nodejs-app'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Node.js Version') {
            steps {
                sh '''
                    node --version
                    npm --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    set -e

                    echo "===== Backend Dependencies ====="
                    cd backend
                    npm ci

                    echo "===== Frontend Dependencies ====="
                    cd ../frontend
                    npm ci
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    set -e

                    echo "===== Backend Test ====="
                    cd backend
                    npm test

                    echo "===== Frontend Test ====="
                    cd ../frontend
                    npm test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        sonar-scanner \
                        -Dsonar.projectKey=nodejs-app \
                        -Dsonar.sources=backend,frontend
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "===== Docker Build ====="

                    docker build \
                    -t ${IMAGE_NAME}:${IMAGE_TAG} .
                '''
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    echo "===== Trivy Security Scan ====="

                    trivy image \
                    --severity HIGH,CRITICAL \
                    --exit-code 1 \
                    ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                    echo "===== Login to AWS ECR ====="

                    aws ecr get-login-password \
                    --region ${AWS_REGION} | \
                    docker login \
                    --username AWS \
                    --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    echo "===== Push Image to ECR ====="

                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Update Kubeconfig') {
            steps {
                sh '''
                    echo "===== Update EKS Kubeconfig ====="

                    aws eks update-kubeconfig \
                    --region ${AWS_REGION} \
                    --name ${EKS_CLUSTER}

                    kubectl get nodes
                '''
            }
        }

        stage('Helm Deploy') {
            steps {
                sh '''
                    echo "===== Helm Deployment ====="

                    helm upgrade --install ${HELM_RELEASE} ${HELM_CHART} \
                    --namespace nodejs-app \
                    --create-namespace \
                    --set image.repository=${IMAGE_NAME} \
                    --set image.tag=${IMAGE_TAG}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "===== Kubernetes Pods ====="
                    kubectl get pods -n nodejs-app

                    echo "===== Kubernetes Services ====="
                    kubectl get svc -n nodejs-app

                    echo "===== Deployment Status ====="
                    kubectl rollout status \
                    deployment/${HELM_RELEASE} \
                    -n nodejs-app
                '''
            }
        }
    }

    post {

        success {
            echo '======================================'
            echo 'Deployment successful!'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo 'Pipeline failed. Check the failed stage.'
            echo '======================================'
        }
    }
}
```
