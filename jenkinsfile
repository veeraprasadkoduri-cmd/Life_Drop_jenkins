pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                deleteDir()

                git branch: 'main',
                    url: 'https://github.com/veeraprasadkoduri-cmd/Life_Drop_jenkins.git'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    set -e

                    echo "Building Backend..."
                    docker compose build backend

                    echo "Building Frontend..."
                    docker compose build frontend
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "$DOCKER_PASSWORD" | docker login \
                          -u "$DOCKER_USERNAME" \
                          --password-stdin

                        echo "Pushing Backend..."
                        docker push veeradockerhub/lifedrop-backend:latest

                        echo "Pushing Frontend..."
                        docker push veeradockerhub/lifedrop-frontend:latest

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    set -e

                    echo "Checking EKS access..."
                    kubectl get nodes

                    echo "Deploying LifeDrop using Helm..."

                    helm upgrade --install lifedrop k8s/lifedrop \
                        --namespace lifedrop \
                        --create-namespace \
                        --wait \
                        --timeout 10m

                    echo "Helm deployment completed."
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -e

                    echo "Pods:"
                    kubectl get pods -n lifedrop -o wide

                    echo ""
                    echo "Services:"
                    kubectl get svc -n lifedrop

                    echo ""
                    echo "Deployments:"
                    kubectl get deployments -n lifedrop
                '''
            }
        }
    }

    post {

        success {
            echo 'LifeDrop EKS deployment SUCCESSFUL'
        }

        failure {
            echo 'LifeDrop EKS deployment FAILED'
        }
    }
}
