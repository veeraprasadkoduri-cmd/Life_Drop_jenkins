```groovy
pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'

        AWS_ACCOUNT_ID = '426714791148'

        ECR_BACKEND  = 'lifedrop-backend'
        ECR_FRONTEND = 'lifedrop-frontend'

        BACKEND_IMAGE = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_BACKEND}:${BUILD_NUMBER}"
        FRONTEND_IMAGE = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_FRONTEND}:${BUILD_NUMBER}"

        S3_BUCKET = 'life_drop'
        S3_PATH = "lifedrop/build-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                deleteDir()

                git branch: 'main',
                    url: 'https://github.com/veeraprasadkoduri-cmd/Life_Drop_jenkins.git'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    set -e

                    echo "Building Backend Image..."

                    docker build \
                        -t "$BACKEND_IMAGE" \
                        ./backend

                    echo "Building Frontend Image..."

                    docker build \
                        -t "$FRONTEND_IMAGE" \
                        ./frontend

                    echo "Docker images created successfully."

                    docker images
                '''
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    set -e

                    echo "Scanning Backend Image..."

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        "$BACKEND_IMAGE"

                    echo "Scanning Frontend Image..."

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        "$FRONTEND_IMAGE"

                    echo "Trivy scan PASSED."
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                    set -e

                    echo "Logging into AWS ECR..."
 
                    aws ecr get-login-password \
                        --region "$AWS_REGION" | \
                    docker login \
                        --username AWS \
                        --password-stdin \
                        "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                '''
            }
        }

        stage('Push Images to ECR') {
            steps {
                sh '''
                    set -e

                    echo "Pushing Backend Image..."

                    docker push "$BACKEND_IMAGE"

                    echo "Pushing Frontend Image..."

                    docker push "$FRONTEND_IMAGE"

                    echo "Images successfully pushed to ECR."
                '''
            }
        }

        stage('Deploy to Docker') {
            steps {
                sh '''
                    set -e

                    echo "Stopping old application..."

                    docker compose down || true

                    echo "Pulling latest images from ECR..."

                    docker pull "$BACKEND_IMAGE"
                    docker pull "$FRONTEND_IMAGE"

                    echo "Starting LifeDrop application..."

                    docker compose up -d

                    echo "Docker deployment completed."
                '''
            }
        }

        stage('Verify Docker Deployment') {
            steps {
                sh '''
                    set -e

                    echo "=============================="
                    echo "Docker Containers"
                    echo "=============================="

                    docker ps

                    echo "=============================="
                    echo "Container Health"
                    echo "=============================="

                    docker compose ps

                    echo "=============================="
                    echo "Backend  Image"
                    echo "=============================="

                    docker images | grep lifedrop || true

                    echo "Docker deployment verification completed."
                '''
            }
        }

        stage('Create Artifacts') {
            steps {
                sh '''
                    set -e

                    echo "Creating build artifacts..."

                    mkdir -p artifacts

                    tar -czf \
                        "artifacts/lifedrop-build-${BUILD_NUMBER}.tar.gz" \
                        backend \
                        frontend \
                        docker-compose.yml

                    echo "Artifact created:"

                    ls -lh artifacts/
                '''
            }
        }

        stage('Upload Artifacts to S3') {
            steps {
                sh '''
                    set -e

                    echo "Uploading artifacts to S3..."

                    aws s3 cp artifacts/ \
                        "s3://${S3_BUCKET}/${S3_PATH}/" \
                        --recursive \
                        --region "$AWS_REGION"

                    echo "S3 upload completed successfully."

                    echo "S3 Location:"
                    echo "s3://${S3_BUCKET}/${S3_PATH}/"
                '''
            }
        }
    }

    post {
        success {
            echo '''
            ==========================================
            LifeDrop CI/CD PIPELINE SUCCESSFUL
            ==========================================
            Docker Build    : PASSED
            Trivy Scan      : PASSED
            ECR Push        : PASSED
            Docker Deploy   : PASSED
            Verification    : PASSED
            S3 Artifact     : UPLOADED
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
            LifeDrop CI/CD PIPELINE FAILED
            ==========================================
            Check the failed Jenkins stage and logs.
            ==========================================
            '''
        }
    }
}
```
