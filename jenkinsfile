pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        AWS_REGION     = 'ap-south-1'
        AWS_ACCOUNT_ID = '424957012022'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        FRONTEND_REPO = 'lifedrop-frontend'
        BACKEND_REPO  = 'lifedrop-backend'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/veeraprasadkoduri-cmd/Life_Drop_jenkins.git'
            }
        }

        stage('Login to ECR') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-ecr-credentials']
                ]) {
                    sh '''
                        set -e

                        echo "Checking AWS credentials..."
                        aws sts get-caller-identity

                        echo "Logging in to ECR..."
                        aws ecr get-login-password \
                            --region ${AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${ECR_REGISTRY}
                    '''
                }
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    set -e

                    docker build \
                        -t ${ECR_REGISTRY}/${BACKEND_REPO}:${IMAGE_TAG} \
                        -t ${ECR_REGISTRY}/${BACKEND_REPO}:latest \
                        ./backend
                '''
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    set -e

                    docker build \
                        -t ${ECR_REGISTRY}/${FRONTEND_REPO}:${IMAGE_TAG} \
                        -t ${ECR_REGISTRY}/${FRONTEND_REPO}:latest \
                        ./frontend
                '''
            }
        }

        stage('Push Backend to ECR') {
            steps {
                sh '''
                    set -e

                    docker push \
                        ${ECR_REGISTRY}/${BACKEND_REPO}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REGISTRY}/${BACKEND_REPO}:latest
                '''
            }
        }

        stage('Push Frontend to ECR') {
            steps {
                sh '''
                    set -e

                    docker push \
                        ${ECR_REGISTRY}/${FRONTEND_REPO}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REGISTRY}/${FRONTEND_REPO}:latest
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    set -e

                    docker compose down || true

                    docker compose pull

                    docker compose up -d
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "===== Docker Compose ====="
                    docker compose ps

                    echo "===== Docker Containers ====="
                    docker ps
                '''
            }
        }
    }

    post {
        success {
            echo 'LifeDrop deployment completed successfully.'
        }

        failure {
            echo 'LifeDrop deployment failed. Check the stage above for the error.'
        }

        always {
            sh '''
                docker logout ${ECR_REGISTRY} || true
            '''
        }
    }
}
